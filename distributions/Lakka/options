### DISTRO INFORMATION ###

DISTRONAME="Lakka"

DESCRIPTION="Lakka offline retro gaming console"

DISTRO_WEBSITE="https://www.lakka.tv/"

BUILD_NO_VERSION="yes"


### USER INTERFACE SETTINGS ###

GREETING0="###########################################"
GREETING1="# Lakka Offline Gaming Console            #"
GREETING2="###########################################"
GREETING3=""
GREETING4=""

ROOT_PASSWORD="root"

DISTRO_BOOTLABEL="LAKKA"
DISTRO_DISKLABEL="LAKKA_DISK"


### BUILDSYSTEM SETTINGS ####

LTO_SUPPORT="yes"

GOLD_SUPPORT="yes"

MOLD_SUPPORT="no"

DEFAULT_LINKER="gold"

HARDENING_SUPPORT="no"

GET_HANDLER_SUPPORT="archive git"

LOCAL_CCACHE_SUPPORT="yes"


### OS CONFIGURATION ###

GLIBC_LOCALES="no"


if [ "${TARGET_ARCH}" = "arm" ]; then
  ARM_MEM_SUPPORT="yes"
else
  ARM_MEM_SUPPORT="no"
fi


# No Xbox Bluetooth driver
ADDITIONAL_DRIVERS=""


SYSTEM_SIZE=${SYSTEM_SIZE:-1024}

SYSTEM_PART_START=8192

STORAGE_SIZE=32


# No swap
SWAP_SUPPORT="no"

SWAP_ENABLED_DEFAULT="no"


DEBUG_TTY="/dev/tty3"


### LAKKA SETTINGS ###

MEDIACENTER="lakka"


PULSEAUDIO_SUPPORT="no"

PIPEWIRE_SUPPORT="no"


# Keep Bluetooth for controllers
BLUETOOTH_SUPPORT="yes"


# No network discovery
AVAHI_DAEMON="no"


DISTRO_MIRROR="http://sources.libreelec.tv/mirror"

DISTRO_SRC="http://sources.libreelec.tv/$LIBREELEC_VERSION"


ISCSI_SUPPORT="no"


# No network filesystem
NFS_SUPPORT="no"

SAMBA_SUPPORT="no"

SAMBA_SERVER="no"

SFTP_SERVER="no"
SSH_SUPPORT="yes"


# No VPN
OPENVPN_SUPPORT="no"

WIREGUARD_SUPPORT="no"


# Keep this if you want removable game storage/cartridges
UDEVIL="yes"


INITRAMFS_PARTED_SUPPORT="no"


# No text editor
NANO_EDITOR="no"


# No scheduled tasks
CRON_SUPPORT="no"


# No installer
INSTALLER_SUPPORT="no"


WINDOWMANAGER="none"


# Controller support
JOYSTICK_SUPPORT="yes"


OEM_SUPPORT="no"


# Audio
ALSA_SUPPORT="yes"


# Extra packages
ADDITIONAL_PACKAGES=""


LAKKA_MIRROR="http://sources.lakka.tv"


SKIP_VIRTUAL_APPLIANCE="yes"


# Remove menu/database assets
LIBRETRO_OPTIONAL=""


# Update server
  LAKKA_BUILD_TYPE="${LAKKA_BUILD_TYPE:-release}"

  if [ -z "${LAKKA_UPDATE_SERVER_URL}" ]; then
    case ${LAKKA_BUILD_TYPE} in
      release)
        LAKKA_UPDATE_SERVER_URL="http://le.builds.lakka.tv"
        ;;
      nightly)
        LAKKA_UPDATE_SERVER_URL="http://nightly.builds.lakka.tv/.updater"
        ;;
      devel)
        LAKKA_UPDATE_SERVER_URL="http://nightly.builds.lakka.tv/.devbuild"
        ;;
    esac
  fi
