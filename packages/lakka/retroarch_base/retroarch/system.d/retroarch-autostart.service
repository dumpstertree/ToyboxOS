[Unit]
Description=RetroArch game autostart
After=require_hid_mouse.service require_hid_keyboard.service require_hid_gamepad.service require_hid_storage.service  
Before=retroarch.service

[Service]
Type=oneshot
ExecStart=/usr/share/retroarch/autostart.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
